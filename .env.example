# Local model and adapter configuration
BASE_MODEL=HuggingFaceTB/SmolLM2-135M-Instruct
# Leave revisions empty to use the pinned defaults; set them when changing models.
BASE_MODEL_REVISION=
ADAPTER_PATH=artifacts/support-lora-adapter
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=

# Retrieval and generation controls
TOP_K=3
MIN_SCORE=0.30
MAX_SEQUENCE_LENGTH=256
MAX_NEW_TOKENS=80

# Laptop-friendly LoRA training controls
TRAIN_EPOCHS=8
LEARNING_RATE=0.0002
RANDOM_SEED=42

# Optional Qdrant files; each command rebuilds the index (not a reuse cache).
# Leave empty for in-memory storage.
VECTOR_STORAGE_PATH=
